  "description": "Evidence-backed DeepSeek Harness plugin radar and 2Origin plugin lab",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-awesome": "./bin/dsh-awesome.mjs"
  },
  "files": [
    "bin/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "discover": "node scripts/discover.mjs",
    "discover:capabilities": "node scripts/discover-capabilities.mjs",
